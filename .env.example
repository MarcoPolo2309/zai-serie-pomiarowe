# Skopiuj do .env (lub ustaw zmienne w środowisku). Nie zapisuj prawdziwych haseł w repozytorium.
DATABASE_URL=postgres://zai:zai@localhost:55432/zai
# Konto administratora tworzone przy pierwszym starcie (hasło trafia do bazy jako Argon2id)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
PORT=3000
# Ważność tokenu sesji w sekundach
SESSION_TTL_SECONDS=3600
# Katalog z zbudowanym frontendem (opcjonalnie)
FRONTEND_DIR=../frontend/dist
NODE_ENV=development
